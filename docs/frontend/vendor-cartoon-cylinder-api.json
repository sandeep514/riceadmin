        }
      },
      "listByUser": {
        "method": "GET",
        "path": "/api/portal/web/cylinder-product/list/{userId}",
        "auth": true
      },
      "show": {
        "method": "GET",
        "path": "/api/portal/web/cylinder-product/{id}",
        "auth": true
      },
      "delete": {
        "method": "DELETE",
        "path": "/api/portal/web/cylinder-product/{id}",
        "auth": true
      },
      "deleteVariantImage": {
        "method": "DELETE",
        "path": "/api/portal/web/cylinder-product/image/{imageId}",
        "auth": true,
        "pathParams": {
          "imageId": "web_cylinder_product_variants.id"
        }
      }
    },
    "responseShapes": {
      "product": {
        "id": "number",
        "userId": "number",
        "cylinderTypeId": "number|null",
        "otherTypeValue": "string|null",
        "specification": "string|null",
        "description": "string|null",
        "additionalInformation": "string|null",
        "status": "number (0=pending, 1=verified)",
        "variants": "Variant[]"
      },
      "variant": {
        "id": "number",
        "packingSizeId": "number|null",
        "packingSize": "string|null",
        "otherSizeValue": "string|null",
        "rate": "string|null",
        "gst": "string|null",
        "totalPrice": "string|null",
        "bagSize": "string|null",
        "bagWeight": "string|null",
        "image": "string|null",
        "imageUrl": "string|null",
        "sortOrder": "number"
      },
      "vendorCatalogProduct": {
        "id": "number",
        "cylinderTypeId": "number|null",
        "otherTypeValue": "string|null",
        "cylinderTypeName": "string|null",
        "specification": "string|null",
        "description": "string|null",
