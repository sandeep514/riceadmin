        "variants": "Variant[]"
      },
      "imageBasePath": "uploads/cylinder-products/{userId}"
    }
  },
  "errors": {
    "401": { "status": false, "message": "Unauthorized: API token is required." },
    "403": { "status": false, "message": "Forbidden: ..." },
    "404": { "status": false, "message": "Product not found." },
    "422": { "status": false, "message": "Validation failed.", "errors": {} }
  }
}
