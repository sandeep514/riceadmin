APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Use reverb for WebSockets (see docs/REACT_REVERB_SETUP.md). log = no real-time push.
BROADCAST_DRIVER=reverb

# Laravel Reverb (must match the SPA VITE_/REACT_APP_ vars: key, host, port, scheme)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Hostname the *browser* connects to (IP or domain). No quotes needed in .env.
REVERB_HOST=localhost
# Port the browser uses for ws/wss (often 443 behind Nginx, or same as REVERB_SERVER_PORT)
REVERB_PORT=8080
# http = ws:// (OK only if the SPA is also http). https:// Netlify/GitHub Pages require https here = wss://
REVERB_SCHEME=http

# Comma-separated browser Origins for the WebSocket handshake. If set, must include your SPA, e.g.:
# REVERB_ALLOWED_ORIGINS=https://sntc.netlify.app
# Leave unset to allow all origins (see config/reverb.php).

# Process that `php artisan reverb:start` binds to (must be reachable from REVERB_HOST:REVERB_PORT or from Nginx proxy).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
CACHE_DRIVER=file
# sync = send immediately (no worker). Use database + `php artisan queue:work` for queued mail.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
